# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ── Worker / fila em memória ──────────────────────────────────────────────────
# Mensagens processadas em paralelo
QUEUE_CONCURRENCY=2
# Tentativas totais antes da DLQ (inclui a primeira)
QUEUE_MAX_ATTEMPTS=3
# Base do backoff exponencial com jitter
QUEUE_RETRY_BASE_DELAY_MS=250
# Prazo de uma tentativa; ao estourar, o slot é liberado e a mensagem reagendada
QUEUE_HANDLER_TIMEOUT_MS=15000

# ── Mock do LLM (só na PoC) ───────────────────────────────────────────────────
# Latência simulada: é o que reproduz o incidente
LLM_MIN_LATENCY_MS=500
LLM_MAX_LATENCY_MS=4000
# Probabilidade de falha transitória, entre 0 e 1
LLM_FAILURE_RATE=0.3
