# Porta do servidor HTTP
PORT=3000
HOST=0.0.0.0

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Worker / fila em memoria
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_DELAY_MS=250

# Mock do LLM (PoC): latencia simulada e taxa de falha
LLM_MIN_LATENCY_MS=500
LLM_MAX_LATENCY_MS=4000
LLM_FAILURE_RATE=0.3
